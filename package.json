{
  "name": "project-harness",
  "version": "0.4.2",
  "description": "AI-assisted project harness with infer-before-implement discovery, engineering defaults, and deterministic execution controls.",
  "main": "dsh/index.js",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "dsh/index.js",
    "dsh/skill-catalog.json",
    "dsh/skills",
    "dsh/specialists",
    ".github/skills",
    "scripts",
    "AGENTS.md",
    "AI-NOTES.md",
    "ENGINEERING-DEFAULTS.md",
    "HARNESS-LOOP.md",
    "PROJECT-INTAKE.md",
    "PROJECT-TYPES.md",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "setup": "node scripts/harness-init.js",
    "lock": "node scripts/lock-project.js lock",
    "unlock": "node scripts/lock-project.js unlock",
    "status": "node scripts/lock-project.js status",
    "control:verify": "node scripts/project-control.js verify",
    "memory:resume": "node scripts/project-control.js resume",
    "memory-summary": "node scripts/project-control.js resume",
    "memory:checkpoint": "node scripts/project-control.js checkpoint",
    "decision": "node scripts/project-control.js decision",
    "destination": "node scripts/project-control.js destination",
    "handoff": "node scripts/project-handoff.js",
    "vcs": "node scripts/vcs-control.js",
    "vcs:status": "node scripts/vcs-control.js status",
    "vcs:preflight": "node scripts/vcs-control.js preflight",
    "skills:verify": "node scripts/skills-verify.js",
    "skills:catalog": "node scripts/skills-catalog.js",
    "dsh:verify": "node scripts/dsh-integration-check.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "harness",
    "planning",
    "discovery",
    "skills",
    "version-control"
  ],
  "author": "Shaun Palmer",
  "license": "MIT"
}
